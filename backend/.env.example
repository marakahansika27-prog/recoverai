# RecoverAI Backend Environment Variables Example
PROJECT_NAME="RecoverAI — Autonomous Revenue Recovery Agent"
API_V1_STR="/api/v1"

# Database URL (SQLite for local, PostgreSQL for Supabase/Render production)
# DATABASE_URL="sqlite:///./recoverai_revenue.db"
